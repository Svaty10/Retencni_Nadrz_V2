# Auto detect text files and perform LF normalization
* text=auto

# Source code files
*.c text eol=lf
*.h text eol=lf
Makefile text eol=lf
*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Raspberry Pi / Linux files - must stay LF (shebang, systemd, bash)
*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf
*.path text eol=lf
*.timer text eol=lf
*.conf text eol=lf
system/config/default-retencka text eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.cmd text eol=crlf
