[Unit]
Description=Retenční nádrž – přijímač CC1101, databáze a web
After=network.target time-sync.target retencka-identity.service
Wants=network.target
# never give up restarting
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=retencka
Group=retencka
SupplementaryGroups=spi gpio
EnvironmentFile=-/etc/default/retencka
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 RETENCKA_DATA=/var/lib/retencka/data
# glibc: few arenas + return big blocks (scrypt) to the OS -> low, stable RSS
Environment=MALLOC_ARENA_MAX=2 MALLOC_MMAP_THRESHOLD_=131072 MALLOC_TRIM_THRESHOLD_=131072
WorkingDirectory=/var/lib/retencka/app/current/server
# one-shot database restore from the boot partition (runs as root, "+")
ExecStartPre=+/var/lib/retencka/app/current/system/bin/retencka-restore.sh
ExecStart=/usr/bin/python3 -m retencka
Restart=always
RestartSec=3
TimeoutStartSec=60
TimeoutStopSec=10
# app pings systemd only while the event loop AND the radio thread are alive
WatchdogSec=60

# --- resources (Pi Zero 2 W, 512 MB) ---
MemoryHigh=48M
MemoryMax=64M
OOMScoreAdjust=-500
Nice=-2

# --- sandbox ---
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/retencka/data
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
DevicePolicy=closed
DeviceAllow=/dev/spidev0.0 rw
DeviceAllow=/dev/gpiochip0 rw
UMask=0027

[Install]
WantedBy=multi-user.target
