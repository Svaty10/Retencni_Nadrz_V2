[Unit]
Description=Retenční nádrž – kontrola a instalace aktualizací
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /var/lib/retencka/app/current/system/bin/retencka-update.py
TimeoutStartSec=15min
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/retencka /etc/systemd/system
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
