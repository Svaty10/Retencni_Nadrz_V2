[Unit]
Description=Retenční nádrž – akce s právy roota na žádost aplikace (restart, servisní přístup)

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /var/lib/retencka/app/current/system/bin/retencka-control.py
TimeoutStartSec=15min
# No ProtectSystem/ProtectHome/RestrictSUIDSGID: the NetBird install runs apt/dpkg and
# `netbird service install`, which write all over /etc, /usr, /var/lib and need gpg's
# home in /root. Only restrictions that cannot get in the way of a package install:
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
