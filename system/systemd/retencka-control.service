[Unit]
Description=Retenční nádrž – akce s právy roota na žádost aplikace (restart, servisní přístup)

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /var/lib/retencka/app/current/system/bin/retencka-control.py
TimeoutStartSec=15min
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/retencka -/etc/netbird -/etc/apt -/usr/share/keyrings -/usr/bin -/usr/lib -/var/lib/apt -/var/lib/dpkg -/var/cache/apt -/var/log
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
